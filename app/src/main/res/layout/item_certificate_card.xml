<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DevLoveTool.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_squircle"
                android:padding="7dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Certificate"
                    android:src="@drawable/ic_security" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_cert_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Active Signing Certificate"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subject -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_cert_subject"
            android:textColor="@color/secondary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tv_cert_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="CN=..."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Issuer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_cert_issuer"
            android:textColor="@color/secondary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tv_cert_issuer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="CN=..."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="12.5sp" />

        <!-- Serial & Algorithm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_serial"
                    android:textColor="@color/secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_cert_serial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="00:11:22:33"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_algorithm"
                    android:textColor="@color/secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_cert_algo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="SHA256withRSA"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Validity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_valid_from"
                    android:textColor="@color/secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_cert_valid_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="2020-01-01"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_valid_to"
                    android:textColor="@color/secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_cert_valid_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="2050-01-01"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fingerprints Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mono_block"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_cert_sha256"
                android:textColor="@color/secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cert_sha256"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="AA:BB:CC:..."
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_cert_sha1"
                android:textColor="@color/secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cert_sha1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="AA:BB:CC:..."
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_cert_md5"
                android:textColor="@color/secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cert_md5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="AA:BB:CC:..."
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
