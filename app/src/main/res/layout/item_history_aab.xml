<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DevLoveTool.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_squircle"
                android:padding="9dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="AAB Bundle Icon"
                    android:src="@drawable/ic_transform" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_hist_aab_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="base-release.aab"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hist_aab_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="Built: 2026-11-12"
                    android:textColor="@color/secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hist_aab_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="21.11 MB"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/divider_subtle" />

        <!-- Source APK & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Source APK"
                    android:textColor="@color/secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_hist_aab_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="base.apk"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hist_aab_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_granted"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="Signed (RSA-SHA256)"
                android:textColor="@color/success"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Signing Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signed With Keystore &amp; Alias"
            android:textColor="@color/secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_hist_aab_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="my_app_keystore.jks (key0)"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Certificate SHA-256 & Path Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_mono_block"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CERTIFICATE SHA-256"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hist_aab_sha256"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="AA:BB:CC:DD..."
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUTPUT LOCATION"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hist_aab_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="/storage/emulated/0/..."
                android:textColor="@color/secondary"
                android:textIsSelectable="true"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Actions: Save to Folder & Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hist_aab_save"
                style="@style/DevLoveTool.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save to Folder"
                android:textColor="@color/primary"
                android:textSize="12.5sp"
                app:icon="@drawable/ic_save"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary_ring" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hist_aab_share"
                style="@style/DevLoveTool.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Share"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                app:icon="@drawable/ic_share"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/border_strong" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
