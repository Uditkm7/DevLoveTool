<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_squircle"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Select App"
                android:src="@drawable/ic_apps" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select APK Source"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick an installed package or browse device files"
                android:textColor="@color/secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_picker_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="0 Apps"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/edittext_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/et_picker_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search installed application or package…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Storage Alternative Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_picker_browse_storage"
        style="@style/DevLoveTool.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="Browse Storage / File Manager (SAF)"
        android:textColor="@color/primary"
        app:icon="@drawable/ic_folder_open"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/primary"
        app:strokeColor="@color/primary_ring" />

    <!-- Compact Apps List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_picker_apps"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        android:scrollbars="vertical" />

</LinearLayout>
