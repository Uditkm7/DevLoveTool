<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="2dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tv_step_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/console_success"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_step_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@color/console_surface"
        android:fontFamily="@font/jetbrains_mono"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="+0.2s"
        android:textColor="@color/console_accent"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/tv_step_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:fontFamily="@font/jetbrains_mono"
        android:text="Extracting AndroidManifest.xml"
        android:textColor="@color/console_text"
        android:textSize="11.5sp" />

</LinearLayout>
